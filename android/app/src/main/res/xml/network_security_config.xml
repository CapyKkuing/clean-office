<?xml version="1.0" encoding="utf-8"?>
<!-- 같은 와이파이 안의 PC(192.168.x.x 등)와 http로 주고받기 위해 평문 통신을 허용한다.
     안드로이드는 IP 대역별 허용을 지원하지 않아 전체 허용이 불가피함.
     보호 장치: 접속은 사용자가 찍은 QR 주소로만, 매 요청에 비밀 연결 코드, 앱 안내문에 공용 와이파이 사용 금지. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
